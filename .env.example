# ---------------------------------------------------------------- required
# Token from @BotFather. Never commit the real value.
BOT_TOKEN=

# Redis connection. With a password: redis://:password@host:6379/0 (use rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- admin / support
# Telegram username users can contact with questions (without @)
ADMIN_USERNAME=legend_axad

# ---------------------------------------------------------------- mysql (user data + download history)
# Leave MYSQL_HOST empty to run without MySQL (nothing is saved to a database).
# Docker Compose sets MYSQL_HOST=mysql automatically.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=downloader
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=downloader_bot
# Only used by docker-compose to initialise the MySQL container
MYSQL_ROOT_PASSWORD=change-me-too

# ---------------------------------------------------------------- telegram
# Optional self-hosted Bot API server (raises the upload limit to 2000 MB), e.g.
# TELEGRAM_API_BASE_URL=http://telegram-bot-api:8081/bot
TELEGRAM_API_BASE_URL=
# Max upload size in MB: 50 for the public Bot API.
MAX_UPLOAD_MB=50

# ---------------------------------------------------------------- limits
MAX_DURATION_SECONDS=10800
WORKER_CONCURRENCY=2
METADATA_CONCURRENCY=4
MAX_ACTIVE_TASKS_PER_USER=2
USER_REQUESTS_PER_MINUTE=10

# ---------------------------------------------------------------- timeouts & retries
METADATA_TIMEOUT_SECONDS=60
DOWNLOAD_TIMEOUT_SECONDS=1800
PROCESSING_TIMEOUT_SECONDS=1800
UPLOAD_TIMEOUT_SECONDS=600
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=15
STALE_TASK_SECONDS=120
SESSION_TTL_SECONDS=1800
TASK_TTL_SECONDS=86400
SHUTDOWN_GRACE_SECONDS=45

# ---------------------------------------------------------------- runtime
DOWNLOAD_DIR=downloads
LOG_LEVEL=INFO
# text (human readable) or json (production / log aggregation)
LOG_FORMAT=text
# Optional rotating log file, e.g. logs/bot.log (stdout is always used)
LOG_FILE=
# JavaScript runtime(s) for yt-dlp's YouTube support: deno and/or node
YTDLP_JS_RUNTIMES=node
# Optional explicit worker name (defaults to <hostname>-<pid>)
WORKER_NAME=
